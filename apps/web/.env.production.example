# ============================================================
# TURF PRO — Configuration de PRODUCTION (modèle)
# Copier vers `.env.production` (JAMAIS committé) sur le serveur.
# ============================================================

# --- Base de données (mots de passe forts obligatoires) ---
POSTGRES_PASSWORD="CHANGEZ_MOI_mot_de_passe_fort"
DATABASE_URL="postgresql://turfpro:CHANGEZ_MOI_mot_de_passe_fort@postgres:5432/turfpro?schema=public"
REDIS_URL="redis://redis:6379"

# --- URL publique du site ---
APP_URL="https://votre-domaine.com"

# --- Secrets (générés : openssl rand -hex 32) ---
PAYMENT_WEBHOOK_SECRET=""
CRON_SECRET=""

# --- Fournisseur hippique : ne JAMAIS définir sans accord écrit ---
HORSE_RACING_PROVIDER="demo"
# Pour les courses françaises, utiliser uniquement un plan couvrant les cartes du jour et une licence adaptée.
THERACINGAPI_CONTRACT_ACCEPTED=""
RACING_API_USERNAME=""
RACING_API_PASSWORD=""

# --- FedaPay (paiement indisponible en production tant que ces deux secrets manquent) ---
FEDAPAY_SECRET_KEY=""
FEDAPAY_WEBHOOK_SECRET=""
FEDAPAY_API_BASE="https://api.fedapay.com/v1"

# --- Démo navigateur (SIMULATION uniquement, à retirer en réel) ---
NEXT_PUBLIC_DEMO_WEBHOOK_SECRET=""
